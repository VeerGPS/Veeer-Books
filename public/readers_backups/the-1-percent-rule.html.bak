<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The 1% Rule — Veer Sukhadiya</title>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --accent:    #4a8e5e;
  --bg:        #2a2a2a;
  --toolbar-bg:#1a1a1a;
  --toolbar-br:#2e2e2e;
  --btn-bd:    #444;
  --btn-cl:    #ccc;
}

html, body { height: 100%; overflow: hidden; background: var(--bg); font-family: Georgia, serif; transition: background .25s; }

/* Colour modes */
body.sepia  { --bg:#3b2e1e; --toolbar-bg:#251e14; --toolbar-br:#4a3822; }
body.night  { --bg:#111;    --toolbar-bg:#0d0d0d; --toolbar-br:#222;    }

/* Shell */
#shell { display:flex; flex-direction:column; height:100vh; width:100vw; }

/* Toolbar */
#toolbar {
  flex-shrink:0; height:52px; background:var(--toolbar-bg);
  border-bottom:1px solid var(--toolbar-br);
  display:flex; align-items:center; padding:0 .75rem; gap:.4rem;
  z-index:20; overflow-x:auto; overflow-y:hidden; scrollbar-width:none;
}
#toolbar::-webkit-scrollbar { display:none; }

.sep { width:1px; height:24px; background:#333; flex-shrink:0; margin:0 .1rem; }

.tb-btn {
  flex-shrink:0; background:transparent; border:1px solid var(--btn-bd);
  color:var(--btn-cl); font-size:.78rem; padding:.3rem .65rem; border-radius:5px;
  cursor:pointer; white-space:nowrap; transition:background .15s,border-color .15s,color .15s;
  font-family:inherit;
}
.tb-btn:hover:not(:disabled) { background:#333; border-color:#666; color:#fff; }
.tb-btn:disabled { opacity:.3; cursor:default; }
.tb-btn.active { background:var(--accent); border-color:var(--accent); color:#fff; }

#page-counter { color:#999; font-size:.78rem; min-width:72px; text-align:center; flex-shrink:0; }
#book-title   { color:#777; font-style:italic; font-size:.78rem; flex:1; text-align:center;
                  overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
                  padding:0 .25rem; min-width:0; }
#zoom-lbl     { color:#888; font-size:.75rem; min-width:34px; text-align:center; flex-shrink:0; }

/* Viewport */
#viewport {
  flex:1; overflow:auto; display:flex; align-items:flex-start;
  justify-content:center; padding:1.25rem; gap:10px;
  background:var(--bg); transition:background .25s, padding-left .28s ease;
}

/* Page images */
.pg {
  display:block; height:auto; border-radius:3px; flex-shrink:0;
  box-shadow:0 8px 40px rgba(0,0,0,.7); user-select:none; -webkit-user-drag:none;
  transform-origin:top center; transition:filter .25s;
}

/* Single page */
body:not(.two-page) #img-l { max-width:min(100%,720px); width:auto; }
body:not(.two-page) #img-r { display:none !important; }

/* Two-page spread */
body.two-page #img-l,
body.two-page #img-r { max-width:calc(50% - 5px); width:calc(50% - 5px); }
body.two-page.cover-solo #img-l { max-width:min(100%,720px); width:auto; }
body.two-page.cover-solo #img-r { display:none !important; }

/* Night: invert pages | Sepia: warm tint */
body.night .pg { filter:invert(1) hue-rotate(180deg); }
body.sepia .pg  { filter:sepia(.5) brightness(.97); }

/* Thumbnail strip */
#thumb-strip {
  position:fixed; top:52px; left:0; width:118px;
  height:calc(100vh - 52px); background:#111; border-right:1px solid #222;
  overflow-y:auto; padding:.4rem; display:flex; flex-direction:column; gap:.3rem;
  transform:translateX(-100%); transition:transform .28s ease; z-index:15;
  scrollbar-width:thin; scrollbar-color:#333 #111;
}
#thumb-strip.open { transform:translateX(0); }
body.thumbs-open #viewport { padding-left:calc(118px + 1.25rem); }

.thumb { cursor:pointer; border-radius:3px; overflow:hidden; border:2px solid transparent;
          transition:border-color .12s; position:relative; flex-shrink:0; }
.thumb:hover  { border-color:#555; }
.thumb.active { border-color:var(--accent); }
.thumb img    { display:block; width:100%; height:auto; pointer-events:none; }
.thumb-lbl { position:absolute; bottom:0; left:0; right:0; background:rgba(0,0,0,.55);
              color:#ccc; font-size:.58rem; text-align:center; padding:1px 0; }

@media(max-width:600px) { #book-title{ display:none; } #viewport{ padding:.5rem; } }
</style>
</head>
<body>
<div id="shell">

  <div id="toolbar">
    <button class="tb-btn" id="btn-back">← Store</button>
    <div class="sep"></div>
    <button class="tb-btn" id="btn-prev">◀ Prev</button>
    <span   id="page-counter">1 / 23</span>
    <button class="tb-btn" id="btn-next">Next ▶</button>
    <div class="sep"></div>
    <span id="book-title">The 1% Rule — Veer Sukhadiya</span>
    <div class="sep"></div>
    <button class="tb-btn" id="btn-thumbs">☰</button>
    <div class="sep"></div>
    <button class="tb-btn" id="btn-zoom-out">A−</button>
    <span   id="zoom-lbl">100%</span>
    <button class="tb-btn" id="btn-zoom-in">A+</button>
    <div class="sep"></div>
    <button class="tb-btn" id="btn-1page">1 Page</button>
    <button class="tb-btn" id="btn-2page">2 Pages</button>
    <div class="sep"></div>
    <button class="tb-btn" id="btn-sepia">Sepia</button>
    <button class="tb-btn" id="btn-night">🌙 Night</button>
  </div>

  <div id="thumb-strip"></div>

  <div id="viewport">
    <img id="img-l" class="pg" src="" alt="Page" draggable="false">
    <img id="img-r" class="pg" src="" alt=""     draggable="false" style="display:none">
  </div>

</div>
<script>
(function(){
  'use strict';
  const PAGES = [
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,",
"data:image/jpeg;base64,"
];
  const IS_PREVIEW = new URLSearchParams(window.location.search).get('preview') === '1';
  const PREVIEW_MAX_PAGES = 5;
  if (IS_PREVIEW && PAGES.length > PREVIEW_MAX_PAGES) {
    PAGES.length = PREVIEW_MAX_PAGES;
    const bookTitleEl = document.getElementById('book-title');
    if (bookTitleEl) bookTitleEl.textContent += ' (Preview)';
  }

  const TOTAL = PAGES.length;
  const KEY   = 'rule';

  let cur    = 1, zoom = 1.0, twoPage = false, thumbsBuilt = false;

  const imgL    = document.getElementById('img-l');
  const imgR    = document.getElementById('img-r');
  const counter = document.getElementById('page-counter');
  const zoomLbl = document.getElementById('zoom-lbl');
  const strip   = document.getElementById('thumb-strip');
  const vp      = document.getElementById('viewport');

  function render() {
    const solo = !twoPage || cur === 1;
    imgL.src = PAGES[cur - 1];
    imgL.alt = 'Page ' + cur;
    document.body.classList.toggle('cover-solo', cur === 1 && twoPage);
    if (!solo && cur + 1 <= TOTAL) {
      imgR.src = PAGES[cur]; imgR.alt = 'Page ' + (cur + 1); imgR.style.display = 'block';
    } else { imgR.style.display = 'none'; }
    imgL.style.transform = imgR.style.transform = `scale(${zoom})`;
    imgL.style.transformOrigin = imgR.style.transformOrigin = 'top center';
    const extra = zoom > 1 ? (zoom - 1) * 600 : 0;
    imgL.style.marginBottom = imgR.style.marginBottom = extra + 'px';
    counter.textContent = (!solo && cur + 1 <= TOTAL)
      ? `${cur}–${cur+1} / ${TOTAL}` : `${cur} / ${TOTAL}`;
    document.getElementById('btn-prev').disabled = cur <= 1;
    document.getElementById('btn-next').disabled = twoPage
      ? (cur === 1 ? 2 > TOTAL : cur + 2 > TOTAL) : cur >= TOTAL;
    document.querySelectorAll('.thumb').forEach((t,i) =>
      t.classList.toggle('active', i === cur-1 || (!solo && i === cur)));
    const at = strip.children[cur - 1];
    if (at) at.scrollIntoView({ block:'nearest' });
    vp.scrollTo({ top:0, behavior:'smooth' });
    localStorage.setItem(KEY + '_page', cur);
  }

  function goTo(n) { cur = Math.min(Math.max(1, n), TOTAL); render(); }
  function prev()  { twoPage ? goTo(cur <= 1 ? 1 : cur === 2 ? 1 : cur - 2) : goTo(cur - 1); }
  function next()  { twoPage ? goTo(cur === 1 ? 2 : cur + 2) : goTo(cur + 1); }

  function setZoom(z) {
    zoom = Math.min(3, Math.max(0.5, parseFloat(z.toFixed(2))));
    zoomLbl.textContent = Math.round(zoom * 100) + '%';
    imgL.style.transform = imgR.style.transform = `scale(${zoom})`;
    const extra = zoom > 1 ? (zoom - 1) * 600 : 0;
    imgL.style.marginBottom = imgR.style.marginBottom = extra + 'px';
    localStorage.setItem(KEY + '_zoom', zoom);
  }

  function setViewMode(two) {
    twoPage = two;
    document.body.classList.toggle('two-page', two);
    document.getElementById('btn-1page').classList.toggle('active', !two);
    document.getElementById('btn-2page').classList.toggle('active',  two);
    localStorage.setItem(KEY + '_two', two ? '1' : '0');
    render();
  }

  function setMode(m) {
    document.body.classList.remove('night', 'sepia');
    ['btn-night','btn-sepia'].forEach(id => document.getElementById(id).classList.remove('active'));
    if (m) { document.body.classList.add(m); document.getElementById('btn-' + m).classList.add('active'); }
    localStorage.setItem(KEY + '_mode', m || '');
  }

  function buildThumbs() {
    if (thumbsBuilt) return; thumbsBuilt = true;
    PAGES.forEach((src, i) => {
      const d = document.createElement('div'); d.className = 'thumb';
      const img = document.createElement('img'); img.src = src; img.loading = 'lazy';
      const lbl = document.createElement('div'); lbl.className = 'thumb-lbl'; lbl.textContent = i + 1;
      d.appendChild(img); d.appendChild(lbl);
      d.addEventListener('click', () => goTo(i + 1));
      strip.appendChild(d);
    });
  }

  function toggleThumbs() {
    const open = strip.classList.toggle('open');
    document.getElementById('btn-thumbs').classList.toggle('active', open);
    document.body.classList.toggle('thumbs-open', open);
    if (open) buildThumbs();
  }

  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT') return;
    const k = e.key;
    if (k==='ArrowRight'||k==='PageDown') next();
    else if (k==='ArrowLeft'||k==='PageUp') prev();
    else if (k==='Home') goTo(1);
    else if (k==='End')  goTo(TOTAL);
    else if (k==='+'||k==='=') setZoom(zoom+.15);
    else if (k==='-') setZoom(zoom-.15);
    else if (k==='n') setMode(document.body.classList.contains('night')?'':'night');
    else if (k==='s') setMode(document.body.classList.contains('sepia')?'':'sepia');
    else if (k==='1') setViewMode(false);
    else if (k==='2') setViewMode(true);
  });

  let tx = 0;
  vp.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, {passive:true});
  vp.addEventListener('touchend',   e => {
    const dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 48) dx < 0 ? next() : prev();
  }, {passive:true});

  document.getElementById('btn-back').addEventListener('click', () =>
    document.referrer ? window.history.back() : (window.location.href = 'index.html'));
  document.getElementById('btn-prev').addEventListener('click', prev);
  document.getElementById('btn-next').addEventListener('click', next);
  document.getElementById('btn-zoom-in').addEventListener('click',  () => setZoom(zoom+.15));
  document.getElementById('btn-zoom-out').addEventListener('click', () => setZoom(zoom-.15));
  document.getElementById('btn-1page').addEventListener('click', () => setViewMode(false));
  document.getElementById('btn-2page').addEventListener('click', () => setViewMode(true));
  document.getElementById('btn-thumbs').addEventListener('click', toggleThumbs);
  document.getElementById('btn-night').addEventListener('click',
    () => setMode(document.body.classList.contains('night') ? '' : 'night'));
  document.getElementById('btn-sepia').addEventListener('click',
    () => setMode(document.body.classList.contains('sepia') ? '' : 'sepia'));

  // Restore preferences
  const sPage = parseInt(localStorage.getItem(KEY + '_page')) || 1;
  const sZoom = parseFloat(localStorage.getItem(KEY + '_zoom')) || 1.0;
  const sMode = localStorage.getItem(KEY + '_mode') || '';
  const sTwo  = localStorage.getItem(KEY + '_two') === '1';

  setMode(sMode);
  setZoom(sZoom);
  if (sTwo) { twoPage=true; document.body.classList.add('two-page');
               document.getElementById('btn-2page').classList.add('active'); }
  else       { document.getElementById('btn-1page').classList.add('active'); }
  goTo(sPage);
})();
</script>
</body>
</html>